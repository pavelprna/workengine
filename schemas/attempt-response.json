{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workengine.dev/schemas/attempt-response/v1.json",
  "title": "Workengine coding Worker attempt response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workId",
    "executionId",
    "attemptId",
    "workerProfile",
    "result"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "workId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "workerProfile": { "type": "string", "minLength": 1 },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "kind"],
          "properties": {
            "type": { "const": "outcome" },
            "kind": {
              "type": "string",
              "enum": ["succeeded", "failed", "channel_error"]
            },
            "proofs": { "$ref": "outcome.json#/properties/proofs" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requestKind", "prompt"],
          "properties": {
            "type": { "const": "input_required" },
            "requestKind": { "type": "string", "enum": ["question", "consent"] },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      ]
    }
  }
}
