{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workengine.dev/schemas/outcome/v1.json",
  "title": "Workengine Worker outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "workerProfile"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "timed_out",
        "budget_exceeded",
        "channel_error"
      ]
    },
    "workerProfile": { "type": "string", "minLength": 1 },
    "proofs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "mediaType", "sha256", "content"],
        "properties": {
          "kind": { "type": "string", "enum": ["change", "validation"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "content": { "type": "string", "maxLength": 65536 }
        }
      }
    }
  }
}
