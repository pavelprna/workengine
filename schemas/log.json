{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workengine.dev/schemas/log/v1.json",
  "title": "Workengine supervised subprocess stream record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "event"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "workId": { "type": "string", "minLength": 1 },
    "event": {
      "type": "string",
      "enum": ["spawned", "exited", "killed", "child_stdout", "child_stderr"]
    },
    "payload": { "type": "string" }
  }
}
