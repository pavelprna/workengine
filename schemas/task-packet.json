{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workengine.dev/schemas/task-packet/v1.json",
  "title": "Workengine coding Worker task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workId",
    "executionId",
    "attemptId",
    "workerProfile",
    "goal",
    "repository",
    "validationContract",
    "operatorInputsPath"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "workId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "workerProfile": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "revision", "workspacePath"],
      "properties": {
        "identity": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"] },
        "workspacePath": { "type": "string", "const": "/workspace" }
      }
    },
    "validationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "argv"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
              }
            }
          }
        }
      }
    },
    "operatorInputsPath": {
      "type": "string",
      "const": "/workspace/.workengine/operator-inputs.jsonl"
    }
  }
}
